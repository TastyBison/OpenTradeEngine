<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OpenTradeEngine.Screens"
             x:Class="OpenTradeEngine.Screens.AuctionScreen">
    <UserControl.Styles>
        <Style Selector="Button.event-button">
            <Setter Property="Height" Value="64" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#5A5A5E" />
                    <GradientStop Offset="0.48" Color="#4C4C50" />
                    <GradientStop Offset="0.5" Color="#35353B" />
                    <GradientStop Offset="1" Color="#29292F" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid Background="#000033">
        <Grid Margin="44,46,48,54" ColumnDefinitions="52*,58,48*">
            <Border Grid.Column="0" Padding="12" Background="#898994" BorderBrush="#44445D"
                    BorderThickness="7" CornerRadius="17" VerticalAlignment="Stretch">
                <Border Background="White" CornerRadius="12" Padding="18">
                    <Image x:Name="AuctionImage" Stretch="Uniform" />
                </Border>
            </Border>

            <Grid Grid.Column="2" RowDefinitions="Auto,26,*,18,Auto,12,Auto" Margin="0,0,0,2">
                <TextBlock x:Name="Heading" Foreground="White" FontSize="33" FontWeight="Bold"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="OfferText" Foreground="White" FontSize="23" LineHeight="31"
                               TextWrapping="Wrap" TextAlignment="Left" />
                </ScrollViewer>
                <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#FF9A7D" FontSize="18"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Row="6" Classes="event-button event-action" Content="OK" Click="BidButton_Click" />
            </Grid>
        </Grid>
        <local:NumericEntryOverlay x:Name="AmountEntry" ZIndex="100" />
        <local:ConfirmationOverlay x:Name="BidConfirmation" ZIndex="110" />
    </Grid>
</UserControl>
