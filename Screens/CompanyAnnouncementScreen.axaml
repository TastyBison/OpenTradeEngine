<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenTradeEngine.Screens.CompanyAnnouncementScreen">
    <UserControl.Styles>
        <Style Selector="Button.announcement-button">
            <Setter Property="Height" Value="68" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#A1A1AA" />
                    <GradientStop Offset="0.48" Color="#85858F" />
                    <GradientStop Offset="0.5" Color="#686873" />
                    <GradientStop Offset="1" Color="#575762" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid Background="#000033">
        <Grid Margin="42,28,42,22" RowDefinitions="Auto,18,*,20,Auto,24,Auto"
              HorizontalAlignment="Stretch">
            <TextBlock x:Name="Heading" FontSize="38" FontWeight="Bold" Foreground="White"
                       TextAlignment="Center" TextWrapping="Wrap" />

            <Border Grid.Row="2" MaxWidth="1120" MinHeight="300" Padding="10"
                    HorizontalAlignment="Center" Background="#898994" BorderBrush="#44445D"
                    BorderThickness="7" CornerRadius="17">
                <Border x:Name="CompanyImageBackground" Background="White" CornerRadius="10" Padding="20">
                    <Grid>
                        <Image x:Name="BackdropImage" Stretch="UniformToFill" IsVisible="False" />
                        <Image x:Name="CompanyImage" Stretch="Uniform" />
                    </Grid>
                </Border>
            </Border>

            <ScrollViewer Grid.Row="4" MaxWidth="1120" MaxHeight="190"
                          HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Message" MaxWidth="1120" Foreground="White"
                           FontSize="23" LineHeight="31" TextWrapping="Wrap" TextAlignment="Left" />
            </ScrollViewer>

            <Button Grid.Row="6" Classes="announcement-button" Width="560" Content="OK"
                    HorizontalAlignment="Center" Click="ContinueButton_Click" />
        </Grid>
    </Grid>
</UserControl>
