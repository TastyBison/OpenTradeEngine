<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenTradeEngine.Screens.NumericEntryOverlay"
             IsVisible="False">
    <UserControl.Resources>
        <!-- The host window uses Avalonia's dark theme.  Override every themed
             text-control state here so a focused amount field stays white like
             the original Gazillionaire dialog. -->
        <SolidColorBrush x:Key="TextControlBackground">White</SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver">White</SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBackgroundFocused">White</SolidColorBrush>
        <SolidColorBrush x:Key="TextControlForeground">#222222</SolidColorBrush>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver">#222222</SolidColorBrush>
        <SolidColorBrush x:Key="TextControlForegroundFocused">#222222</SolidColorBrush>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>
    </UserControl.Styles>
    <Grid Background="#66000000">
        <Border Width="480" Height="475" Padding="7" Background="#414078" CornerRadius="18"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="39,*">
                <Button Width="31" Height="31" Margin="0,0,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="0" CornerRadius="16" Background="White" Foreground="#626273"
                        FontSize="24" FontWeight="Bold" Content="&#x00D7;" Click="CancelButton_Click" />
                <Border Grid.Row="1" Padding="53,28,53,20" Background="White" CornerRadius="10">
                    <StackPanel Spacing="0">
                        <TextBlock x:Name="HeadingText" Margin="0,0,0,25" Foreground="#2E2E2E" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Name="SummaryText" Margin="0,0,0,28" Foreground="#333333" FontSize="18" LineHeight="25" TextWrapping="Wrap" />
                        <TextBlock x:Name="PromptText" Margin="0,0,0,25" Foreground="#333333" FontSize="18" TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,14" ColumnDefinitions="*,2,*,2,*">
                            <Button Content="Lower" Height="36" Padding="8,2" CornerRadius="8" Background="#414078" Foreground="White" FontSize="17" FontWeight="Bold" Click="LowerButton_Click" />
                            <Button Grid.Column="2" Content="Middle" Height="36" Padding="8,2" CornerRadius="8" Background="#414078" Foreground="White" FontSize="17" FontWeight="Bold" Click="MiddleButton_Click" />
                            <Button Grid.Column="4" Content="Upper" Height="36" Padding="8,2" CornerRadius="8" Background="#414078" Foreground="White" FontSize="17" FontWeight="Bold" Click="UpperButton_Click" />
                        </Grid>
                        <TextBox x:Name="ValueBox" Text="0" Height="42" Padding="5,1" FontSize="22" Foreground="#222222"
                                 Background="White" BorderBrush="#5B9BD5" BorderThickness="2"
                                 SelectionBrush="#5B9BD5" SelectionForegroundBrush="White"
                                 HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                 KeyDown="ValueBox_KeyDown" />
                        <TextBlock x:Name="ErrorText" Margin="0,0,0,30" Foreground="#C0392B" FontSize="15" TextAlignment="Center" MinHeight="16" />
                        <Button Content="OK" Width="125" Height="36" Padding="8,2" CornerRadius="8" HorizontalAlignment="Center"
                                Background="#414078" Foreground="White" FontSize="18" FontWeight="Bold"
                                Click="OkButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
