<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OpenTradeEngine.Screens"
             x:Class="OpenTradeEngine.Screens.MarketplaceScreen">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.filter">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#168BCA" />
            <Setter Property="BorderBrush" Value="#209DD8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.filter.selected">
            <Setter Property="Background" Value="#173A78" />
            <Setter Property="BorderBrush" Value="#6790D4" />
        </Style>
    </UserControl.Styles>
    <Grid Background="#05052B" Margin="24,12,16,12" RowDefinitions="48,*,64" ColumnDefinitions="*,250">
        <Border Grid.Column="0" Margin="0,0,16,8" Background="#E8FAFF" BorderBrush="#74749B" BorderThickness="2">
            <TextBlock x:Name="CargoText" Foreground="#444444" FontSize="17" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" Background="#FAFAFA" BorderBrush="#5D5D79" BorderThickness="10" CornerRadius="14">
            <Grid RowDefinitions="48,*">
                <Grid Background="#74749B" ColumnDefinitions="190,*,*,*,*,1.15*">
                    <TextBlock x:Name="QuickTradeText" Text="Quick Trade Off" Classes="market-head" />
                    <TextBlock Grid.Column="1" Text="Your Cargo" Classes="market-head" />
                    <TextBlock Grid.Column="2" x:Name="PlanetQuantityHeading" Classes="market-head" />
                    <TextBlock Grid.Column="3" Text="You Paid" Classes="market-head" />
                    <TextBlock Grid.Column="4" Text="Market Price" Classes="market-head" />
                    <TextBlock Grid.Column="5" Text="Price Range" Classes="market-head" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CommodityRows" />
                </ScrollViewer>
            </Grid>
        </Border>
        <StackPanel Grid.Column="1" Grid.RowSpan="2" Spacing="22">
            <Border Background="#74749B" CornerRadius="8" Padding="0,5,0,7"><StackPanel Spacing="5">
                <TextBlock Text="Your Cash" Foreground="White" FontSize="22" TextAlignment="Center" />
                <Border Margin="6,0" Padding="8,15" Background="#B9F0FF" CornerRadius="7"><TextBlock x:Name="CashText" Foreground="#202020" FontSize="23" TextAlignment="Center" /></Border>
            </StackPanel></Border>
            <Border Background="#74749B" CornerRadius="8" Padding="0,5,0,7"><StackPanel Spacing="5">
                <TextBlock Text="Profit" Foreground="White" FontSize="22" TextAlignment="Center" />
                <Border Margin="6,0" Padding="8,15" Background="#B9F0FF" CornerRadius="7"><TextBlock x:Name="ProfitText" Foreground="#202020" FontSize="23" TextAlignment="Center" /></Border>
            </StackPanel></Border>
            <Button Content="Buy" Height="80" Background="#65A916" FontSize="23" FontWeight="Bold" HorizontalAlignment="Stretch" Click="BuyButton_Click" />
            <Button Content="Sell" Height="80" Background="#65A916" FontSize="23" FontWeight="Bold" HorizontalAlignment="Stretch" Click="SellButton_Click" />
            <Button x:Name="AvailableFilterButton" Classes="filter" Content="Show Available" Height="84" FontSize="20" HorizontalAlignment="Stretch" Click="ShowAvailableButton_Click" />
            <Button x:Name="CargoFilterButton" Classes="filter" Content="Show Cargo" Height="84" FontSize="20" HorizontalAlignment="Stretch" Click="ShowCargoButton_Click" />
            <Button x:Name="AllFilterButton" Classes="filter" Content="Show All" Height="84" FontSize="20" HorizontalAlignment="Stretch" Click="ShowAllButton_Click" />
            <TextBlock x:Name="StatusText" Foreground="LightGreen" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="*,8,*,8,*,8,72" Margin="0,8,16,0">
            <Button Classes="gameplay-footer" Content="&lt;&lt; Back" HorizontalAlignment="Stretch" Click="BackButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="2" Content="Supply" HorizontalAlignment="Stretch" Click="SupplyButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="4" Content="Warehouse" HorizontalAlignment="Stretch" Click="WarehouseButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="6" Content="?" FontSize="27" Foreground="#FFD51C" Click="HelpButton_Click" />
        </Grid>
        <local:NumericEntryOverlay x:Name="AmountEntry" Grid.RowSpan="3" Grid.ColumnSpan="2" ZIndex="100" />
        <local:InformationOverlay x:Name="HelpOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" ZIndex="110" />
    </Grid>
</UserControl>
