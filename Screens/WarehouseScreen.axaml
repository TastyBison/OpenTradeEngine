<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OpenTradeEngine.Screens"
             x:Class="OpenTradeEngine.Screens.WarehouseScreen">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid Background="#05052B" Margin="24,12,16,12" RowDefinitions="48,*,64" ColumnDefinitions="*,250">
        <Grid Grid.Column="0" Margin="0,0,16,8" ColumnDefinitions="*,14,*">
            <Border Background="#E8FAFF" BorderBrush="#74749B" BorderThickness="2"><TextBlock x:Name="CargoText" Foreground="#444444" FontSize="17" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" /></Border>
            <Border Grid.Column="2" Background="#E8FAFF" BorderBrush="#74749B" BorderThickness="2"><TextBlock x:Name="WarehouseText" Foreground="#444444" FontSize="17" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" /></Border>
        </Grid>
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" Background="#FAFAFA" BorderBrush="#5D5D79" BorderThickness="10" CornerRadius="14">
            <Grid RowDefinitions="48,*">
                <Grid Background="#74749B" ColumnDefinitions="2*,1.2*,1.5*,1.2*">
                    <TextBlock x:Name="QuickText" Text="Quick Warehouse Off" Classes="market-head" />
                    <TextBlock Grid.Column="1" Text="Tons on Ship" Classes="market-head" />
                    <TextBlock Grid.Column="2" Text="Tons In Warehouse" Classes="market-head" />
                    <TextBlock Grid.Column="3" Text="Market Price" Classes="market-head" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Rows" /></ScrollViewer>
            </Grid>
        </Border>
        <StackPanel Grid.Column="1" Grid.RowSpan="2" Spacing="20" Margin="0,55,0,0">
            <Button Content="Store" Height="80" Background="#65A916" FontSize="23" FontWeight="Bold" HorizontalAlignment="Stretch" Click="StoreButton_Click" />
            <Button Content="Take" Height="80" Background="#65A916" FontSize="23" FontWeight="Bold" HorizontalAlignment="Stretch" Click="TakeButton_Click" />
            <Button Content="Show Available" Height="72" FontSize="20" HorizontalAlignment="Stretch" Click="ShowAvailableButton_Click" />
            <Button Content="Show Cargo" Height="72" FontSize="20" HorizontalAlignment="Stretch" Click="ShowCargoButton_Click" />
            <Button Content="Show All" Height="72" FontSize="20" HorizontalAlignment="Stretch" Click="ShowAllButton_Click" />
            <TextBlock Text="Warehouse space is included on every planet."
                       Foreground="White" FontSize="17" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Foreground="LightGreen" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="*,8,*,8,*,8,72" Margin="0,8,16,0">
            <Button Classes="gameplay-footer" Content="&lt;&lt; Back" HorizontalAlignment="Stretch" Click="BackButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="2" Content="Supply" HorizontalAlignment="Stretch" Click="SupplyButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="4" Content="Marketplace" HorizontalAlignment="Stretch" Click="MarketplaceButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="6" Content="?" FontSize="27" Foreground="#FFD51C" Click="HelpButton_Click" />
        </Grid>
        <local:NumericEntryOverlay x:Name="AmountEntry" Grid.RowSpan="3" Grid.ColumnSpan="2" ZIndex="100" />
        <local:InformationOverlay x:Name="HelpOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" ZIndex="110" />
    </Grid>
</UserControl>
