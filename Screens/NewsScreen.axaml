<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenTradeEngine.Screens.NewsScreen">
    <Grid Background="#030303">
        <Image x:Name="StarsImage" Stretch="UniformToFill" Opacity="0.55" />
        <Border Width="900" Padding="38" Background="#EC08080A" BorderBrush="#555560" BorderThickness="7"
                CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="22">
                <TextBlock Text="Kukubian Business News" Foreground="White" FontSize="35" FontWeight="Bold" TextAlignment="Center" />
                <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NewsText" Foreground="White" FontSize="20" TextWrapping="Wrap" />
                </ScrollViewer>
                <Button Content="Continue" Height="56" Click="ContinueButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
