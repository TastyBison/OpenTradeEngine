<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenTradeEngine.Screens.AboutLavaMindScreen">
    <Grid Background="#030303">
        <Image x:Name="StarsImage" Stretch="UniformToFill" />
        <Rectangle Fill="#20000000" />
        <Grid Margin="22" ColumnDefinitions="54*,46*" ColumnSpacing="30">
            <Border Grid.Column="0" Background="#91919D" BorderBrush="#4B4B62"
                    BorderThickness="5" CornerRadius="17" Padding="12">
                <Border Background="White" CornerRadius="11" Padding="5">
                    <Image x:Name="PageArtwork" Stretch="Uniform" />
                </Border>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="18">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">
                        <TextBlock x:Name="PageHeading" Foreground="White" FontSize="29"
                                   FontWeight="Bold" TextAlignment="Center" />
                        <TextBlock x:Name="PageBody" Foreground="White" FontSize="18"
                                   LineHeight="27" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="1" Content="OK" Width="300" Height="58"
                        HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                        Foreground="White" Background="#333333" BorderBrush="#606060"
                        CornerRadius="12" Click="OkButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
