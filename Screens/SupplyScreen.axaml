<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OpenTradeEngine.Screens"
             x:Class="OpenTradeEngine.Screens.SupplyScreen">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid Background="#05052B" Margin="24,12,16,12" RowDefinitions="48,*,64" ColumnDefinitions="*,250">
        <Border Grid.Column="0" Margin="0,0,16,8" Background="#E8FAFF" BorderBrush="#74749B" BorderThickness="2">
            <TextBlock x:Name="CargoText" Foreground="#444444" FontSize="17" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" Background="#FAFAFA" BorderBrush="#5D5D79" BorderThickness="10" CornerRadius="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Column="1" Grid.RowSpan="2" Spacing="22">
            <Border Background="#74749B" CornerRadius="8" Padding="0,5,0,7"><StackPanel Spacing="5">
                <TextBlock Text="Your Cash" Foreground="White" FontSize="22" TextAlignment="Center" />
                <Border Margin="6,0" Padding="8,15" Background="#B9F0FF" CornerRadius="7"><TextBlock x:Name="CashText" Foreground="#202020" FontSize="23" TextAlignment="Center" /></Border>
            </StackPanel></Border>
            <Border Background="#74749B" CornerRadius="8" Padding="0,5,0,7"><StackPanel Spacing="5">
                <TextBlock Text="Profit" Foreground="White" FontSize="22" TextAlignment="Center" />
                <Border Margin="6,0" Padding="8,15" Background="#B9F0FF" CornerRadius="7"><TextBlock Text="0" Foreground="#202020" FontSize="23" TextAlignment="Center" /></Border>
            </StackPanel></Border>
            <Border Height="182" />
            <Button Content="Show Available" Height="84" FontSize="20" HorizontalAlignment="Stretch" Click="ShowAvailableButton_Click" />
            <Button Content="Show Cargo" Height="84" FontSize="20" HorizontalAlignment="Stretch" Click="ShowCargoButton_Click" />
            <Button Content="Show All" Height="84" FontSize="20" HorizontalAlignment="Stretch" Click="ShowAllButton_Click" />
        </StackPanel>
        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="*,8,*,8,*,8,72" Margin="0,8,16,0">
            <Button Classes="gameplay-footer" Content="&lt;&lt; Back" HorizontalAlignment="Stretch" Click="BackButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="2" Content="Marketplace" HorizontalAlignment="Stretch" Click="MarketplaceButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="4" Content="Warehouse" HorizontalAlignment="Stretch" Click="WarehouseButton_Click" />
            <Button Classes="gameplay-footer" Grid.Column="6" Content="?" FontSize="27" Foreground="#FFD51C" Click="HelpButton_Click" />
        </Grid>
        <local:InformationOverlay x:Name="HelpOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" ZIndex="110" />
    </Grid>
</UserControl>
